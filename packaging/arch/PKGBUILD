# okaru-view: compila la rama main del checkout (OKARU_VIEW_REPO, por defecto ~/Projects/okaru-project/okaru-view).
pkgname=okaru-view
pkgver=1.0.0
pkgrel=1
pkgdesc='OKARU (郁): el visor de imágenes'
arch=(x86_64)
url='https://github.com/MrAndyVF/okaru-view'
license=(MIT)
# Sin ABI estable: depende de la versión exacta del núcleo con el que se compiló (la instalada al compilar).
_core=$(pacman -Q okaru-core 2>/dev/null | cut -d' ' -f2)
depends=("okaru-core${_core:+=$_core}" exiv2 gdk-pixbuf2 libraw libjpeg-turbo)
makedepends=(meson ninja pkgconf okaru-core tomlplusplus nlohmann-json stb) # nlohmann-json: la piden las cabeceras del núcleo (okaru-core <= 1.2.4 no la declaraba)
options=('!debug' '!lto')
source=("okaru-view::git+file://${OKARU_VIEW_REPO:-$HOME/Projects/okaru-project/okaru-view}#branch=main")
sha256sums=(SKIP)

pkgver() {
  cd okaru-view
  git describe --long --tags --abbrev=9 --match 'v*' | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  arch-meson okaru-view build -Dtests=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 okaru-view/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
